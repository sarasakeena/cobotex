datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Team {
  id                String     @id @default(cuid())
  code              String     @unique // e.g. "FIRE-01"
  name              String
  category          String     // FIRE | MEDICAL | RESCUE | POLICE | DISASTER
  latitude          Float
  longitude         Float
  address           String?
  status            String     @default("AVAILABLE") // AVAILABLE | BUSY
  currentIncidentId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  assignedIncidents Incident[]
}

model Incident {
  id             String    @id @default(cuid())
  title          String
  description    String
  category       String    // FIRE | ROAD_ACCIDENT | MEDICAL | FLOOD | BUILDING_COLLAPSE | OTHER
  location       String
  latitude       Float?
  longitude      Float?
  address        String?
  tags           String    @default("[]") // Stored as JSON array string
  photo          String?   // Optional base64 or photo URL
  peopleAffected Int       @default(0)
  contactInfo    String?
  severity       String    // LOW | MEDIUM | HIGH | CRITICAL
  status         String    @default("REPORTED") // REPORTED | PENDING | ASSIGNED | IN_PROGRESS | RESOLVED
  assignedTeamId String?
  assignedTeam   Team?     @relation(fields: [assignedTeamId], references: [id])
  assignedAt     DateTime?
  distanceKm     Float?
  etaMinutes     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
